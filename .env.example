## Voxpery environment template for Docker Compose.
##
## Local quick start:
## 1. Copy this file to `.env`.
## 2. Replace the four CHANGE_ME values in section 1 with separate random secrets.
## 3. Run `docker compose up -d --build`, then open http://localhost:5173.
## For a public server, apply section 3 before starting. See docs/DEPLOYMENT.md.
##
## Format: ## explanation | # KEY=value disabled example | KEY=value active setting.
## Keep each active variable defined only once. Never commit your `.env`.
## Optional integrations are disabled until configured; related UI is hidden.
## After changes, rerun `docker compose up -d --build`.
## VITE_* values are public build-time settings, never secrets.

## ==============================================================================
## 1. REQUIRED: CHANGE BEFORE THE FIRST START
## ==============================================================================
## Everyone can read these example values, so they must be replaced. Generate each
## one separately, for example with `openssl rand -hex 32` (64 characters).
## The server refuses to start while JWT_SECRET or LIVEKIT_API_SECRET is a
## CHANGE_ME value, empty, or shorter than 32 characters, and warns about the
## example database password.

## Database superuser password, used for setup and backups only. Set it before the
## first start: the database keeps the password it was created with (changing it
## later needs ALTER ROLE).
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_DATABASE_PASSWORD
## Password of the non-superuser role the server connects with. Compose refuses to
## start the server while it is a CHANGE_ME value or shorter than 16 characters. It
## is applied on every start, so it can be changed here at any time.
POSTGRES_APP_PASSWORD=CHANGE_ME_TO_A_STRONG_APP_DATABASE_PASSWORD
## Shared with the bundled LiveKit server; signs voice room tokens.
LIVEKIT_API_SECRET=CHANGE_ME_TO_A_STRONG_32_PLUS_CHAR_SECRET
## Signs sign-in tokens. Anyone who knows it can sign in as any account.
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET


## ==============================================================================
## 2. LOCAL DEFAULTS
## ==============================================================================
## These defaults run the full stack on this computer, not a public domain.
## Compose sets DATABASE_URL automatically. Native backend runs need their own
## DATABASE_URL and REDIS_URL=redis://localhost:6379; see docs/DEVELOPMENT.md.

POSTGRES_USER=voxpery
POSTGRES_APP_USER=voxpery_app
POSTGRES_DB=voxpery
WEB_PORT=5173

APP_ENV=development
RUST_LOG=info

REDIS_URL=redis://redis:6379
## Memory cap for the bundled Redis container (default 512mb, policy noeviction).
# REDIS_MAXMEMORY=512mb

VITE_API_URL=http://localhost:3001
## Optional public GIPHY key. Leave empty to use only the curated GIF catalog.
VITE_GIPHY_API_KEY=
PUBLIC_API_URL=http://localhost:3001
ATTACHMENTS_PUBLIC_BASE_URL=http://localhost:3001
ATTACHMENTS_MAX_FILE_BYTES=10485760
ATTACHMENTS_ALLOWED_MIME_PREFIXES=image/,video/,audio/,application/pdf,text/plain,application/zip,application/x-zip-compressed,application/octet-stream

LIVEKIT_WS_URL=ws://localhost:7880
## Optional Compose webhook destination; default is the containerized server.
# LIVEKIT_WEBHOOK_URL=http://server:3001/api/webrtc/livekit-webhook
LIVEKIT_API_KEY=devkey

CORS_ORIGINS=http://localhost:5173,tauri://localhost,voxpery://auth
COOKIE_SECURE=0
## Empty by default: forwarded client-IP headers are ignored unless the direct
## reverse proxy source IP/network is explicitly trusted.
TRUSTED_PROXY_CIDRS=


## ==============================================================================
## 3. PRODUCTION OVERRIDES
## ==============================================================================
## Examples only: update the matching active values above, do not duplicate them.
## Replace example.com with your domains; add LIVEKIT_NODE_IP as an active line.
## Configure an HTTPS reverse proxy and LiveKit media firewall ports using
## docs/DEPLOYMENT.md. Changing VITE_* values requires rebuilding the web image.
## Must change for a public server: COOKIE_SECURE=1 (the server refuses non-local
## origins without it) and your own LIVEKIT_API_KEY instead of the `devkey` default.

# APP_ENV=production
# LIVEKIT_API_KEY=your-own-livekit-key-name
# VITE_API_URL=https://api.example.com
# PUBLIC_API_URL=https://api.example.com
# ATTACHMENTS_PUBLIC_BASE_URL=https://api.example.com
# CORS_ORIGINS=https://example.com,tauri://localhost,voxpery://auth
# COOKIE_SECURE=1
## Only if using forwarded client-IP headers: trust your exact proxy IP/network,
## not this example address without checking your deployment.
# TRUSTED_PROXY_CIDRS=172.20.0.1/32
# LIVEKIT_WS_URL=wss://livekit.example.com
# LIVEKIT_NODE_IP=YOUR_SERVER_PUBLIC_IPV4


## ==============================================================================
## 4. OPTIONAL INTEGRATIONS
## ==============================================================================
## Leave these commented out for the simplest self-hosted setup.
## To enable one, remove # from its variable lines and supply real values.
## To disable it, comment out its variables again. Do not enable empty placeholders.
## Availability is reported through `/api/system/features`.

## Seed admin account created at startup when all three values are set. The
## server skips it while the password is a CHANGE_ME value or under 12 characters.
# ADMIN_EMAIL=you@example.com
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_ADMIN_PASSWORD

## Cloudflare Turnstile CAPTCHA. Configure both keys for your web hostname.
# VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
# TURNSTILE_SITE_KEY=your-turnstile-site-key # optional server-side browser handoff override
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
## Local tests only: Cloudflare provides dummy keys that do not protect against bots.
## https://developers.cloudflare.com/turnstile/troubleshooting/testing/

## Google OAuth. Disabled unless both values are set.
## Register this Authorized redirect URI in your Google Cloud OAuth client:
## <PUBLIC_API_URL>/api/auth/google/callback (derived by the app, not another ENV).
## Local: http://localhost:3001/api/auth/google/callback
## Production example: https://api.example.com/api/auth/google/callback
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

## Email delivery. Requires SMTP_HOST, SMTP_USER and SMTP_PASSWORD; uses STARTTLS/587.
## FRONTEND_URL must be your web app URL, used for reset and verification links.
## Use http://localhost:5173 locally, or your own HTTPS domain in production.
# FRONTEND_URL=https://example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
## Set true only with working email delivery to require email verification.
# EMAIL_VERIFICATION_REQUIRED=false

## Malware scanning. Also start Compose with `--profile security`.
# ATTACHMENTS_CLAMAV_ENABLED=1
# ATTACHMENTS_CLAMAV_FAIL_CLOSED=1

## Privacy-safe operational observability. Disabled by default for self-hosting.
## When enabled, the backend logs only allowlisted event codes and coarse client/status fields.
# OBSERVABILITY_ENABLED=true
# OBSERVABILITY_RATE_LIMIT_MAX=120
# OBSERVABILITY_RATE_LIMIT_WINDOW_SECS=60

## External TURN server. Usually not needed for local/dev.
# TURN_URLS=turn:turn.example.com:3478?transport=udp
# TURN_SHARED_SECRET=CHANGE_ME_TO_A_STRONG_TURN_SECRET
# TURN_CREDENTIAL_TTL_SECS=3600
