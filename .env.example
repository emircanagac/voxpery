# Voxpery environment template.
#
# Quick start:
# 1. Copy this file to `.env`.
# 2. Replace the CHANGE_ME values below.
# 3. Run `docker compose up -d --build`.
#
# Optional integrations near the bottom are disabled while commented out.
# Disabled integrations are hidden by the web and desktop UI.

# ==============================================================================
# 1. REQUIRED SETUP
# ==============================================================================

POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_DATABASE_PASSWORD
LIVEKIT_API_SECRET=CHANGE_ME_TO_A_STRONG_32_PLUS_CHAR_SECRET
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_ADMIN_PASSWORD


# ==============================================================================
# 2. LOCAL DEFAULTS
# ==============================================================================

POSTGRES_USER=voxpery
POSTGRES_DB=voxpery
WEB_PORT=5173

APP_ENV=development
RUST_LOG=info

REDIS_URL=redis://redis:6379

VITE_API_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:3001
ATTACHMENTS_PUBLIC_BASE_URL=http://localhost:3001

LIVEKIT_WS_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey

CORS_ORIGINS=http://localhost:5173,tauri://localhost,voxpery://auth
COOKIE_SECURE=0

ADMIN_EMAIL=admin@local
ADMIN_USERNAME=admin


# ==============================================================================
# 3. PRODUCTION OVERRIDES
# ==============================================================================
# Set these when serving Voxpery from real domains over HTTPS.

# APP_ENV=production
# VITE_API_URL=https://api.example.com
# PUBLIC_API_URL=https://api.example.com
# ATTACHMENTS_PUBLIC_BASE_URL=https://api.example.com
# CORS_ORIGINS=https://example.com,tauri://localhost,voxpery://auth
# COOKIE_SECURE=1
# LIVEKIT_WS_URL=wss://livekit.example.com
# LIVEKIT_NODE_IP=YOUR_SERVER_PUBLIC_IPV4


# ==============================================================================
# 4. OPTIONAL INTEGRATIONS
# ==============================================================================
# Leave these commented out for the simplest self-hosted setup.
# The server reports disabled integrations through `/api/system/features`, and
# web/desktop clients hide the related UI.

## Cloudflare Turnstile CAPTCHA.
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

## Google OAuth. Disabled unless both values are set.
# Redirect URI: http://localhost:3001/api/auth/google/callback
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

## Email delivery. Enables password reset and email verification when all values are set.
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_VERIFICATION_REQUIRED=false

## Malware scanning. Also start Compose with `--profile security`.
# ATTACHMENTS_CLAMAV_ENABLED=1
# ATTACHMENTS_CLAMAV_FAIL_CLOSED=1

## External TURN server. Usually not needed for local/dev.
# TURN_URLS=
# TURN_SHARED_SECRET=CHANGE_ME_TO_A_STRONG_TURN_SECRET
