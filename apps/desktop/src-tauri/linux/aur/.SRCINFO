pkgbase = voxpery-bin
	pkgdesc = Open-source and self-hostable community chat with voice and screen sharing
	pkgver = @VERSION@
	pkgrel = 1
	url = https://voxpery.com
	arch = x86_64
	license = AGPL-3.0-only
	depends = gtk4
	depends = nss
	depends = alsa-lib
	depends = libcups
	depends = libdrm
	depends = mesa
	depends = libxkbcommon
	depends = libxcomposite
	depends = libxdamage
	depends = libxrandr
	depends = libx11
	depends = at-spi2-core
	depends = dbus
	depends = hicolor-icon-theme
	optdepends = gnome-keyring: keeps you signed in (or another Secret Service provider)
	optdepends = xdg-desktop-portal: file dialogs and screen sharing on Wayland
	provides = voxpery
	conflicts = voxpery
	options = !strip
	options = !debug
	source = https://github.com/emircanagac/voxpery/releases/download/v@VERSION@/Voxpery_@VERSION@_amd64.deb
	sha256sums = @SHA256@

pkgname = voxpery-bin
