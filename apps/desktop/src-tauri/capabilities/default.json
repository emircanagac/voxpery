{
    "$schema": "../gen/schemas/desktop-schema.json",
    "capabilities": [
        {
            "identifier": "default",
            "description": "Default production-safe capabilities for the bundled desktop app.",
            "windows": [
                "main"
            ],
            "permissions": [
                "core:path:default",
                "core:event:default",
                "core:window:default",
                "core:webview:default",
                "core:app:default",
                "core:image:default",
                "core:resources:default",
                "core:menu:default",
                "core:tray:default",
                "autostart:allow-enable",
                "autostart:allow-disable",
                "autostart:allow-is-enabled",
                "process:allow-restart",
                "updater:default",
                "secure-storage:default",
                "opener:allow-default-urls",
                {
                    "identifier": "http:default",
                    "allow": [
                        {
                            "url": "https://api.voxpery.com/**"
                        }
                    ]
                }
            ]
        },
        {
            "identifier": "dev-local-api",
            "description": "Development-only capability for the localhost frontend and local backend.",
            "windows": [
                "main"
            ],
            "local": false,
            "remote": {
                "urls": [
                    "http://tauri.localhost/**",
                    "https://tauri.localhost/**",
                    "http://localhost:5173/**",
                    "http://127.0.0.1:5173/**"
                ]
            },
            "permissions": [
                "core:path:default",
                "core:event:default",
                "core:window:default",
                "core:webview:default",
                "core:app:default",
                "core:image:default",
                "core:resources:default",
                "core:menu:default",
                "core:tray:default",
                "autostart:allow-enable",
                "autostart:allow-disable",
                "autostart:allow-is-enabled",
                "process:allow-restart",
                "updater:default",
                "secure-storage:default",
                "opener:allow-default-urls",
                {
                    "identifier": "http:default",
                    "allow": [
                        {
                            "url": "http://localhost:3001/**"
                        },
                        {
                            "url": "http://127.0.0.1:3001/**"
                        }
                    ]
                }
            ]
        }
    ]
}
