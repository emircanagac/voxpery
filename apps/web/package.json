  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:e2e": "node scripts/dev-e2e.mjs",
    "build": "tsc -b && vite build",
    "check:initial-bundle": "node scripts/check-initial-bundle.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui-smoke": "playwright test --project=chromium --grep @core",
    "test:e2e:ui-smoke:firefox": "playwright test --project=firefox --grep @core",
    "test:e2e:ui-regressions": "playwright test e2e/core-ui-smoke.spec.ts e2e/auth-core-regressions.spec.ts e2e/channel-permission-core-regressions.spec.ts e2e/issue-354-release-regressions.spec.ts e2e/legal-pages.spec.ts e2e/release-settings-core-regressions.spec.ts e2e/social-friend-core-regressions.spec.ts e2e/server-settings-core-regressions.spec.ts e2e/invite-desktop-core-regressions.spec.ts e2e/chat-scroll-regressions.spec.ts e2e/issue-361-chat-state.spec.ts e2e/floating-stream-regressions.spec.ts e2e/social-activity-regressions.spec.ts e2e/live-audit-ui-regressions.spec.ts --project=chromium",
    "test:e2e:mobile-smoke": "playwright test e2e/mobile-web-smoke.spec.ts --project=mobile-chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "smoke:e2e": "node scripts/smoke-e2e.mjs",
    "smoke:release-deploy": "node scripts/release-deploy-smoke.mjs",
    "chaos:reconnect": "node scripts/chaos-reconnect.mjs",
    "regression:multi-user": "node scripts/regression-multi-user.mjs",
    "load:realtime": "node scripts/realtime-load-smoke.mjs",
    "rate-limit:check": "node scripts/rate-limit-check.mjs"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "1.6.3",
    "@shiguredo/rnnoise-wasm": "2025.1.5",
    "@tanstack/react-virtual": "3.14.22",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-autostart": "2.7.0",
    "@tauri-apps/plugin-deep-link": "2.6.2",
    "@tauri-apps/plugin-global-shortcut": "2.4.1",
    "@tauri-apps/plugin-http": "2.8.3",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.0",
    "livekit-client": "2.23.0",
    "lucide-react": "0.577.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/ui": "4.1.12",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "16.5.0",
    "jsdom": "28.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "ws": "8.22.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.65.0",
    "@rollup/rollup-win32-x64-msvc": "4.65.0"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "undici": "^7.24.0",
    "picomatch": "^4.0.4",
    "brace-expansion": "^5.0.12",
    "source-map-js": "^1.2.2"
  }
}
